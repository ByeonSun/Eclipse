# 복사해서 .env.local 로 저장한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
# 프런트엔드에는 공개용 값만 넣습니다. service_role 키, sb_secret_ 키, DB 비밀번호는 절대 넣지 마세요.

# Supabase 프로젝트 URL (Project Settings → API / Data API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 공개용 키: publishable 키(sb_publishable_...) 또는 legacy anon 키
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
